{
  "name": "docs",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "format": "prettier --write .",
    "lint": "ng lint --fix",
    "build:lib": "ng build angular-material-palette-generator",
    "publish:lib": "cd dist/angular-material-palette-generator && npm publish && cd -",
    "predocs": "rm -rf docs",
    "docs": "ng build --base-href='/angular-material-palette-generator/'",
    "postdocs": "mv dist/docs/browser docs && cp docs/index.html docs/404.html",
    "palette-matching": "npm start --prefix palette-matching --"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/cdk": "^22.2.7",
    "@angular/common": "^22.2.6",
    "@angular/compiler": "^22.2.6",
    "@angular/core": "^22.2.6",
    "@angular/forms": "^22.2.6",
    "@angular/material": "^22.2.7",
    "@angular/platform-browser": "^22.2.6",
    "@angular/router": "^22.2.6",
    "@fontsource/roboto": "^5.3.0",
    "@fontsource/roboto-mono": "^5.3.0",
    "@material-symbols/font-600": "^0.49.0",
    "colorjs.io": "^0.7.1",
    "js-cookie": "^3.0.8",
    "rxjs": "~7.8.2",
    "tslib": "^2.9.1",
    "wcag-contrast-utils": "^1.0.2"
  },
  "devDependencies": {
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.6",
    "@eslint/js": "^10.0.1",
    "@types/js-cookie": "^3.0.6",
    "angular-eslint": "22.7.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^31.0.1",
    "ng-packagr": "^22.2.6",
    "prettier": "^3.10.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.73.0",
    "vitest": "^5.1.0"
  },
  "workspaces": [
    "palette-matching"
  ]
}
